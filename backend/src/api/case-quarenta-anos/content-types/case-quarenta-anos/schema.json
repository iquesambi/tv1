{
  "kind": "collectionType",
  "collectionName": "case_quarenta_anos",
  "info": {
    "singularName": "case-quarenta-anos",
    "pluralName": "cases-quarenta-anos",
    "displayName": "Cases 40 Anos"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "titulo": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "titulo",
      "required": true
    },
    "Data": {
      "type": "date"
    },
    "imagem_capa": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "imagem_timeline": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "clicavel": {
      "type": "enumeration",
      "enum": ["clicável", "não clicável"],
      "default": "clicável"
    },
    "cliente": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::cliente.cliente"
    },
    "blocos": {
      "type": "dynamiczone",
      "components": [
        "blocks.subtitulo",
        "blocks.subcase",
        "blocks.texto",
        "blocks.imagem-simples",
        "blocks.galeria",
        "blocks.imagem-trio",
        "blocks.video",
        "blocks.big-numbers"
      ]
    }
  }
}
