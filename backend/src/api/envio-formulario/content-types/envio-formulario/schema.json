{
  "kind": "collectionType",
  "collectionName": "envios_formulario",
  "info": {
    "singularName": "envio-formulario",
    "pluralName": "envios-formulario",
    "displayName": "Envios de Formulário",
    "description": "Tudo que chega pelos formulários do site. Os que passam da cota diária do Resend ficam como pendentes e são enviados quando a cota volta."
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "tipo": {
      "type": "enumeration",
      "enum": ["seja-cliente", "trabalhe-conosco", "outros-assuntos"],
      "required": true
    },
    "status": {
      "type": "enumeration",
      "enum": ["pendente", "enviado", "erro"],
      "default": "pendente",
      "required": true
    },
    "nome": {
      "type": "string"
    },
    "dados": {
      "type": "json"
    },
    "curriculo_nome": {
      "type": "string"
    },
    "curriculo_base64": {
      "type": "text",
      "private": true
    },
    "tentativas": {
      "type": "integer",
      "default": 0
    },
    "ultimo_erro": {
      "type": "text"
    },
    "enviado_em": {
      "type": "datetime"
    }
  }
}
